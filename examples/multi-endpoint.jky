# Deterministic multi-endpoint lab workflow. All observations are synthetic.
mode lab
target ["WIN-LAB-01", "UBU-LAB-01"]

collect system_information as hostinfo
collect processes as procs
collect network_connections as conns
collect event_logs profile="triage" since=24h as logs
correlate [hostinfo, procs, conns, logs] using "triage-v1" within 15m as incident
timeline incident as chronology
risk incident using "triage-v1" as assessment
verify evidence
report html "multi-endpoint.html"
